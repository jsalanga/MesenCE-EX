<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:m="clr-namespace:Mesen"
	xmlns:l="using:Mesen.Localization"
	xmlns:mcp="using:Mesen.Mcp"
	mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="215"
	x:Class="Mesen.Mcp.McpServerWindow"
	x:DataType="mcp:McpServerWindowViewModel"
	Width="520" Height="215"
	CanResize="False"
	Icon="/Assets/Network.png"
	Title="{l:Translate wndTitle}"
>
	<Design.DataContext>
		<mcp:McpServerWindowViewModel />
	</Design.DataContext>

	<DockPanel Margin="5">
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 5 0 0">
			<Button MinWidth="70" HorizontalContentAlignment="Center" Click="Settings_OnClick" Content="{l:Translate btnSettings}" />
			<Button MinWidth="70" HorizontalContentAlignment="Center" IsCancel="True" Click="Close_OnClick" Content="{l:Translate btnClose}" />
		</StackPanel>

		<Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
			<TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Translate lblStatus}" VerticalAlignment="Center" Margin="0 0 10 0" />
			<TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="Bold" />

			<TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Translate lblUrl}" VerticalAlignment="Center" Margin="0 5 10 0" />
			<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Url}" IsReadOnly="True" Margin="0 5 0 0" />
			<Button Grid.Row="1" Grid.Column="2" Content="{l:Translate btnCopy}" Click="CopyUrl_OnClick" Margin="3 5 0 0" MinWidth="60" HorizontalContentAlignment="Center" />

			<TextBlock Grid.Row="2" Grid.Column="0" Text="{l:Translate lblClaudeCode}" VerticalAlignment="Center" Margin="0 5 10 0" />
			<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ClaudeCodeCommand}" IsReadOnly="True" Margin="0 5 0 0" />
			<Button Grid.Row="2" Grid.Column="2" Content="{l:Translate btnCopy}" Click="CopyCommand_OnClick" Margin="3 5 0 0" MinWidth="60" HorizontalContentAlignment="Center" />

			<TextBlock Grid.Row="3" Grid.Column="0" Text="{l:Translate lblWriteAccess}" VerticalAlignment="Center" Margin="0 5 10 0" />
			<TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding WriteAccess}" VerticalAlignment="Center" Margin="0 5 0 0" />

			<TextBlock Grid.Row="4" Grid.Column="0" Text="{l:Translate lblActivity}" VerticalAlignment="Center" Margin="0 5 10 0" />
			<TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Activity}" VerticalAlignment="Center" Margin="0 5 0 0" />

			<TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Text="{l:Translate lblSecurityHint}" TextWrapping="Wrap" Margin="0 10 0 0" />
		</Grid>
	</DockPanel>
</Window>
